# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- Бренд (весь ребрендинг — здесь) ---
BRAND_NAME=Nuvora
BRAND_TAGLINE=Соцсеть, где светятся идеи
BRAND_PLUS=Nuvora+
BRAND_EMAIL=support@example.com
BRAND_COLOR=#18181b
SITE_URL=https://example.com

# --- Обязательно ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ВНИМАНИЕ: смена ключа разлогинит всех пользователей.
SECRET_KEY=
OWNER_USERNAME=rubl

# --- База и файлы ---
# DATABASE_URL=postgresql://user:pass@localhost:5432/nuvora
# UPLOAD_DIR=/root/quant/uploads

# Регистрация только по инвайт-коду (пусто — открытая регистрация)
BETA_CODE=

# --- Почта (подтверждение email, сброс пароля, поддержка) ---
SMTP_HOST=smtp.mail.ru
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Push-уведомления (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:support@example.com

# --- Вход через Яндекс ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# YANDEX_REDIRECT_URI=https://example.com/auth/yandex/callback

