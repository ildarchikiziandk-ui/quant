# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- Бренд (весь ребрендинг — здесь) ---
BRAND_NAME=Nuvora
BRAND_TAGLINE=Соцсеть, где светятся идеи
BRAND_PLUS=Nuvora+
# почта для вопросов (на сайте и в документах); коды подтверждения уходят с адреса SMTP_USER
BRAND_EMAIL=support@example.com
BRAND_COLOR=#18181b
SITE_URL=https://example.com

# --- Обязательно ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ВНИМАНИЕ: смена ключа разлогинит всех пользователей.
SECRET_KEY=
OWNER_USERNAME=rubl

# --- База и файлы ---
# DATABASE_URL=postgresql://user:pass@localhost:5432/nuvora
# UPLOAD_DIR=/root/quant/uploads

# Регистрация только по инвайт-коду (пусто — открытая регистрация)
BETA_CODE=

# --- Почта (подтверждение email, сброс пароля, поддержка) ---
SMTP_HOST=smtp.mail.ru
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Push-уведомления (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:support@example.com

# --- Вход через Яндекс ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# YANDEX_REDIRECT_URI=https://example.com/auth/yandex/callback


# --- Закон РФ: оператор персональных данных (152-ФЗ) — попадает в /privacy и /consent ---
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
SERVER_LOCATION=Россия, Москва
MIN_AGE=14

# --- Шифрование ---
# MESSAGE_KEY=  # 32 байта в base64; если не задан — выводится из SECRET_KEY (тогда SECRET_KEY менять нельзя)
SECRET_CHATS_ENABLED=1
# Дней хранения шифротекста секретных чатов после таймера/удаления. Для реестра ОРИ — 180.
SECRET_RETAIN_DAYS=0
